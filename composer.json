{
    "name": "silverstripe/auditor",
    "description": "Adds security audit trail to SilverStripe.",
    "type": "silverstripe-vendormodule",
    "keywords": [
        "silverstripe",
        "audit"
    ],
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.3",
        "silverstripe/framework": "^6",
        "monolog/monolog": "^3.2",
        "psr/log": "^3",
        "tractorcow/silverstripe-proxy-db": "^3"
    },
    "require-dev": {
        "silverstripe/recipe-testing": "^4",
        "silverstripe/versioned": "^3",
        "silverstripe/standards": "^1"
    },
    "repositories": [
        {
            "type": "git",
            "url": "git@github.com:silverstripeltd/silverstripe-proxy-db.git"
        }
    ],
    "autoload": {
        "psr-4": {
            "SilverStripe\\Auditor\\": "code/",
            "SilverStripe\\Auditor\\Tests\\": "tests/"
        }
    },
    "extra": [],
    "minimum-stability": "dev",
    "prefer-stable": true
}
